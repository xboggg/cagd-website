# CAGD deploy settings template (new host: SFTP over SSH).
# Copy to .env.deploy and fill in:  cp .env.deploy.example .env.deploy
# .env.deploy is git-ignored and must NEVER be committed.
SSH_USER="your-cpanel-username"
SSH_HOST="your.server.ip.or.host"
SSH_PORT="21098"                 # cPanel SSH port (ask host if not shown)
SSH_KEY=".ssh/cagd_deploy"       # path to your private key (relative to project or absolute)
REMOTE_ROOT="public_html"        # web root on server (or public_html/yourdomain)
