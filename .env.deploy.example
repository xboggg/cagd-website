# CAGD deploy settings template (method: cPanel API token over HTTPS).
# Copy to .env.deploy and fill in:  cp .env.deploy.example .env.deploy
# .env.deploy is git-ignored and must NEVER be committed.
CPANEL_USER="your-cpanel-username"
CPANEL_HOST="your.server.ip"
CPANEL_PORT="2083"
CPANEL_TOKEN="your-cpanel-api-token"   # cPanel → Security → Manage API Tokens → Create
REMOTE_ROOT="public_html"              # web root (or public_html/yourdomain)
